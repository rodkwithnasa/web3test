# Account number of account 1 - as used on etherscan

acct1=hex string with 0x prefix

# Account number of account 2 - as used on etherscan

acct2=hex string with 0x prefix

# Private Key of Acct 1

PK1=hex string no 0x prefix

# Private Key of Acct 2

PK2=hex string no 0x prefix

# Infura API key (from Infura account)

infura_api_key=hex string no 0x prefix

# Infura API key secret used in basic authentication (from Infura account)

infura_api_key_secret=hex string no 0x prefix